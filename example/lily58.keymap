/*
 * Minimal Lily58 keymap exercising the VFX module.
 *
 * Kept deliberately small: it exists so CI compiles the module against a real
 * ZMK build, and so the devicetree in the README has something to point at.
 */

#include <behaviors.dtsi>
#include <behaviors/vfx.dtsi>
#include <dt-bindings/zmk/keys.h>
/* The RGB_* constants for the &rgb_ug bindings below, which exercise the
 * compatibility shim. They are not pulled in by dt-bindings/zmk/vfx.h.
 */
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/vfx.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                              &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                               &kp Y  &kp U    &kp I     &kp O   &kp P    &kp MINUS
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                               &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B  &vfx VFX_TOG   &vfx VFX_NEXT &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                 &kp LALT &kp LGUI &mo 1  &kp SPACE                           &kp RET &mo 2   &kp RGUI  &kp RALT
            >;
        };

        /* Underglow controls. The &rgb_ug bindings work too, through the
         * compatibility shim, which is the point of keeping it.
         */
        lower_layer {
            bindings = <
&trans &trans      &trans      &trans      &trans      &trans                             &trans &trans &trans &trans &trans &trans
&trans &vfx VFX_ON &vfx VFX_OFF &vfx VFX_BRI &vfx VFX_BRD &trans                          &trans &trans &trans &trans &trans &trans
&trans &vfx VFX_SPI &vfx VFX_SPD &vfx VFX_HUI &vfx VFX_HUD &trans                         &trans &trans &trans &trans &trans &trans
&trans &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans &trans &trans &trans &trans &trans &trans &trans &trans
                    &trans &trans &trans &trans                                           &trans &trans &trans &trans
            >;
        };

        raise_layer {
            bindings = <
&trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans
              &trans &trans &trans &trans                      &trans &trans &trans &trans
            >;
        };
    };
};
