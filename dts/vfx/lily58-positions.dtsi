 *
 * Default LED positions for a Lily58, for effects that radiate.
 *
 * Generated by sim/derive-positions.py. The firmware cannot know how a strip
 * was routed, so this assumes the common arrangement: 36 LEDs snaked under
 * each half's key field in a 6x6 grid, with the halves side by side. It is
 * a starting point, not a measurement.
 *
 * Units are about 10 per LED spacing, which is the convention the effect
 * distance properties are tuned for.
 *
 *   #include <vfx/lily58-positions.dtsi>
 *
 *   &vfx_engine {
 *       pixel-positions = <VFX_LILY58_POSITIONS>;
 *   };
 *
 * If ripples radiate in the wrong shape on your board, this list is the thing
 * to correct: replace it with your own x,y pairs, one per pixel across the
 * whole keyboard, in strip order.
 */

#pragma once

#define VFX_LILY58_POSITIONS \
            0 0  10 0  20 0  30 0  40 0  50 0 \
            50 8  40 8  30 8  20 8  10 8  0 8 \
            0 16  10 16  20 16  30 16  40 16  50 16 \
            50 24  40 24  30 24  20 24  10 24  0 24 \
            0 32  10 32  20 32  30 32  40 32  50 32 \
            50 40  40 40  30 40  20 40  10 40  0 40 \
            80 0  90 0  100 0  110 0  120 0  130 0 \
            130 8  120 8  110 8  100 8  90 8  80 8 \
            80 16  90 16  100 16  110 16  120 16  130 16 \
            130 24  120 24  110 24  100 24  90 24  80 24 \
            80 32  90 32  100 32  110 32  120 32  130 32 \
            130 40  120 40  110 40  100 40  90 40  80 40
