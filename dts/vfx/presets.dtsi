 * SPDX-License-Identifier: MIT
 *
 * Ready-made scenes, so VFX is usable without authoring any devicetree.
 *
 *   #include <vfx/presets.dtsi>
 *
 *   &vfx_engine {
 *       status = "okay";
 *       default-scene = <&vfx_aurora>;
 *   };
 *
 * Zones and scenes are matched by compatible wherever they sit in the tree,
 * so these do not need to live under the engine node.
 *
 * vfx_all covers the whole strip: zone lengths are clamped to the actual
 * chain-length at runtime, so 255 means "as many pixels as this board has"
 * and the same preset works on a 10 pixel board and a 72 pixel one.
 */

#include <dt-bindings/zmk/vfx.h>

/ {
    vfx_presets {
        vfx_zones {
            vfx_all: vfx_all {
                compatible = "zmk,vfx-zone";
                range = <0 255>;
            };
        };

        vfx_solid_warm: vfx_solid_warm {
            compatible = "zmk,vfx-scene";
            display-name = "Warm";

            base {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_all>;
                color = <VFX_HSB(30, 85, 100)>;
            };
        };

        vfx_aurora: vfx_aurora {
            compatible = "zmk,vfx-scene";
            display-name = "Aurora";

            base {
                compatible = "zmk,vfx-layer-gradient";
                zone = <&vfx_all>;
                stops = <VFX_HSB(200, 100, 40) VFX_HSB(280, 100, 60) VFX_HSB(160, 90, 50)>;
                scroll-speed = <8>;
            };
        };

        vfx_rainbow: vfx_rainbow {
            compatible = "zmk,vfx-scene";
            display-name = "Rainbow";

            base {
                compatible = "zmk,vfx-layer-gradient";
                zone = <&vfx_all>;
                stops = <VFX_HSB(0, 100, 100) VFX_HSB(60, 100, 100) VFX_HSB(120, 100, 100)
                         VFX_HSB(180, 100, 100) VFX_HSB(240, 100, 100) VFX_HSB(300, 100, 100)>;
                scroll-speed = <14>;
            };
        };

        vfx_breathe: vfx_breathe {
            compatible = "zmk,vfx-scene";
            display-name = "Breathe";

            base {
                compatible = "zmk,vfx-layer-breathe";
                zone = <&vfx_all>;
                color = <VFX_HSB(155, 90, 100)>;
                period-ms = <4500>;
                /* Never reaches black, so the power gate stays out of it. */
                min-level = <20>;
            };
        };

        vfx_plasma: vfx_plasma {
            compatible = "zmk,vfx-scene";
            display-name = "Plasma";

            base {
                compatible = "zmk,vfx-layer-plasma";
                zone = <&vfx_all>;
                color = <VFX_HSB(275, 90, 85)>;
                scale = <14>;
                period-ms = <7000>;
                hue-spread = <70>;
            };
        };

        vfx_twinkle: vfx_twinkle {
            compatible = "zmk,vfx-scene";
            display-name = "Twinkle";

            night {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_all>;
                color = <VFX_HSB(235, 100, 10)>;
            };

            stars {
                compatible = "zmk,vfx-layer-twinkle";
                zone = <&vfx_all>;
                blend = <VFX_BLEND_SCREEN>;
                color = <VFX_HSB(45, 25, 100)>;
                period-ms = <1600>;
                density = <55>;
            };
        };

        /* Reactive only, so between keypresses every pixel is black and the
         * power gate cuts the rail. Typing wakes it.
         */
        vfx_reactive: vfx_reactive {
            compatible = "zmk,vfx-scene";
            display-name = "Reactive";

            ripples {
                compatible = "zmk,vfx-layer-ripple";
                zone = <&vfx_all>;
                color = <VFX_HSB(190, 40, 100)>;
                decay-ms = <700>;
                speed = <60>;
                width = <10>;
            };
        };

        /* Rain on a dark pool, which typing also disturbs. Drops from the
         * two sources are the same kind of drop, so they interfere.
         */
        vfx_water: vfx_water {
            compatible = "zmk,vfx-scene";
            display-name = "Water";

            surface {
                compatible = "zmk,vfx-layer-water";
                zone = <&vfx_all>;
                color = <VFX_HSB(205, 95, 30)>;
                crest-color = <VFX_HSB(190, 30, 100)>;
                wavelength = <20>;
                speed = <45>;
                lifetime-ms = <3200>;
                drop-rate-ms = <700>;
                amplitude = <255>;
                damping = <6>;
            };
        };

        /* No rain, so the surface is still until you type, and the still
         * water is black rather than dim: the board draws nothing at rest, so
         * the power gate cuts the rail between keypresses. Raise the colour's
         * brightness if you would rather see the water sitting there, at the
         * cost of keeping the strip powered.
         */
        vfx_water_keys: vfx_water_keys {
            compatible = "zmk,vfx-scene";
            display-name = "Water (typing)";

            surface {
                compatible = "zmk,vfx-layer-water";
                zone = <&vfx_all>;
                color = <VFX_HSB(205, 95, 0)>;
                crest-color = <VFX_HSB(185, 25, 100)>;
                wavelength = <18>;
                speed = <55>;
                lifetime-ms = <2400>;
                amplitude = <255>;
                damping = <7>;
            };
        };

        /* Columns of green falling down the board, with typing starting a
         * drop under the key you pressed. Twelve columns matches the LED
         * columns of the shipped Lily58 map.
         */
        vfx_matrix: vfx_matrix {
            compatible = "zmk,vfx-scene";
            display-name = "Matrix";

            rain {
                compatible = "zmk,vfx-layer-matrix";
                zone = <&vfx_all>;
                color = <VFX_HSB(125, 100, 55)>;
                head-color = <VFX_HSB(110, 25, 100)>;
                speed = <55>;
                tail = <34>;
                drop-rate-ms = <260>;
                columns = <12>;
                jitter = <90>;
                head-size = <9>;
            };
        };

        /* The same rain, but only where you type: a column drops in from the
         * top and lands on the key, and the board is dark between presses so
         * the power gate can cut the rail.
         *
         * It falls far quicker than the ambient rain on purpose. A drop has
         * to cross the whole board to reach a key on the bottom row, and at
         * a rain-like speed that is half a second of waiting before the key
         * you pressed lights up.
         */
        vfx_matrix_keys: vfx_matrix_keys {
            compatible = "zmk,vfx-scene";
            display-name = "Matrix (typing)";

            rain {
                compatible = "zmk,vfx-layer-matrix";
                zone = <&vfx_all>;
                color = <VFX_HSB(125, 100, 60)>;
                head-color = <VFX_HSB(110, 20, 100)>;
                speed = <150>;
                tail = <24>;
                columns = <12>;
                jitter = <0>;
                head-size = <8>;
            };
        };

        vfx_ember: vfx_ember {
            compatible = "zmk,vfx-scene";
            display-name = "Ember";

            /* A dim bed with brighter embers drifting over it, added rather
             * than replaced so the two combine instead of the top layer
             * flattening the one beneath.
             */
            bed {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_all>;
                color = <VFX_HSB(18, 100, 22)>;
            };

            embers {
                compatible = "zmk,vfx-layer-gradient";
                zone = <&vfx_all>;
                blend = <VFX_BLEND_ADD>;
                opacity = <200>;
                stops = <VFX_HSB(10, 100, 55) VFX_HSB(35, 100, 10)>;
                scroll-speed = <5>;
                span = <12>;
            };
        };

        /* Splits the strip into three bands and shows real state in each.
         * The zone ranges assume at least 36 pixels per half; adjust them to
         * your own strip.
         */
        vfx_status_zones {
            vfx_battery_zone: vfx_battery_zone {
                compatible = "zmk,vfx-zone";
                range = <0 6>;
            };

            vfx_profile_zone: vfx_profile_zone {
                compatible = "zmk,vfx-zone";
                range = <8 5>;
            };

            vfx_layer_zone: vfx_layer_zone {
                compatible = "zmk,vfx-zone";
                range = <30 6>;
            };
        };

        vfx_status: vfx_status {
            compatible = "zmk,vfx-scene";
            display-name = "Status";

            wash {
                compatible = "zmk,vfx-layer-solid";
                zone = <&vfx_all>;
                color = <VFX_HSB(220, 40, 6)>;
            };

            battery {
                compatible = "zmk,vfx-layer-battery";
                zone = <&vfx_battery_zone>;
                high-color = <VFX_HSB(120, 100, 70)>;
                low-color = <VFX_HSB(0, 100, 80)>;
                warn-below = <25>;
            };

            profile {
                compatible = "zmk,vfx-layer-ble-profile";
                zone = <&vfx_profile_zone>;
                connected-color = <VFX_HSB(210, 100, 80)>;
                disconnected-color = <VFX_HSB(20, 100, 50)>;
                usb-color = <VFX_HSB(120, 100, 70)>;
            };

            layers {
                compatible = "zmk,vfx-layer-layer-state";
                zone = <&vfx_layer_zone>;
                /* Base layer is black, so it draws nothing and the wash
                 * underneath shows through.
                 */
                colors = <VFX_BLACK VFX_HSB(50, 100, 70) VFX_HSB(280, 100, 70)
                          VFX_HSB(0, 100, 70)>;
            };
        };
    };
};
